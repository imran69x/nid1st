# ==============================================================================
# Bangladesh NID Smart Scanner & OCR Web Application
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE PUBLIC FIREBASE CONFIGURATION
# (Safe to expose to client browser. Must start with NEXT_PUBLIC_)
# Obtain these from your Firebase Console -> Project Settings -> General -> Web App
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY SECRETS
# (NEVER expose to client browser. Do NOT prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Gemini Vision API Key (Google AI Studio Free Tier: https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSyYourGeminiApiKey"

# Firebase Admin SDK Service Account (optional for privileged backend operations)
FIREBASE_ADMIN_PROJECT_ID="your-project-id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. OCR CONFIGURATION
# ------------------------------------------------------------------------------
# OCR Provider: "tesseract" (default local/client-side privacy-first engine) or "google_vision"
OCR_PROVIDER="tesseract"

# Optional Google Cloud Vision API Key or Service Account (Server-side only)
# Used only if OCR_PROVIDER is set to "google_vision" or as backend fallback
GOOGLE_VISION_API_KEY="your-google-cloud-vision-api-key"
