# ==============================================================================
# Bangladesh NID Smart Scanner & OCR Web Application
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE PUBLIC FIREBASE CONFIGURATION
# (Safe to expose to client browser. Must start with NEXT_PUBLIC_)
# Obtain these from your Firebase Console -> Project Settings -> General -> Web App
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY SECRETS
# (NEVER expose to client browser. Do NOT prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Gemini Vision API Key (Google AI Studio Free Tier: https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSyYourGeminiApiKey"

# ------------------------------------------------------------------------------
# 3. MAIN ADMIN CREDENTIALS
# (Stored in env, NOT hardcoded in source code)
# These are used to seed the default admin user in Firestore on first run.
# ------------------------------------------------------------------------------
ADMIN_USERNAME="your_admin_username"
ADMIN_PASSWORD="your_admin_password"

# ------------------------------------------------------------------------------
# 4. OCR CONFIGURATION
# ------------------------------------------------------------------------------
# OCR Provider: "gemini" (AI-powered) or "tesseract" (local/client-side)
OCR_PROVIDER="gemini"
