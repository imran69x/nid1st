rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - managed by server-side API routes
    // In production, consider adding authentication rules
    match /users/{userId} {
      allow read, write: if true;
    }

    // System config collection
    match /system/{docId} {
      allow read, write: if true;
    }

    // Extraction records - user-level access
    match /extractionRecords/{recordId} {
      allow read, write: if true;
    }

    // Recent scans collection
    match /recent_scans/{scanId} {
      allow read, write: if true;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
